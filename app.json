{
  "expo": {
    "scheme": "mangrow",
    "name": "Mangrow",
    "slug": "Mangrow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_logos.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "splash": {
      "image": "./assets/app_logos.png",
      "resizeMode": "contain",
      "backgroundColor": "#CFEFC7"
    },

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app_logos.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },

    "web": {
      "favicon": "./assets/app_logos.png"
    },

    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Mangrow to access your location for geo-tagging mangrove images."
        }
      ]
    ]
  }
}